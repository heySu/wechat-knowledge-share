# ── 服务 ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# 管理后台登录密码（部署到公网前务必修改）
ADMIN_PASSWORD=admin123
# 对外可访问的站点地址，用于生成知识卡片链接
PUBLIC_BASE_URL=http://localhost:3000
# 时区，决定“每日推送”在几点触发
TZ_NAME=Asia/Shanghai

# ── 微信 ─────────────────────────────────────────────
# mock = 本地模拟（默认，无需公众号即可演示）；live = 调用真实微信接口
WECHAT_MODE=mock
WECHAT_APPID=
WECHAT_SECRET=
# 公众号后台「服务器配置」里填写的 Token，必须与此处一致
WECHAT_TOKEN=knowledge
# 图文草稿的封面素材 media_id（live 模式必填，在素材库上传后获取）
THUMB_MEDIA_ID=
# 创建草稿后是否立即提交发布（接口仅对已认证账号开放）
AUTO_PUBLISH=false

# ── 每日推送 ─────────────────────────────────────────
PUSH_TIME=08:30
PUSH_COUNT=3

# ── 账号信息 ─────────────────────────────────────────
ACCOUNT_NAME=知识小站

# ── 数据 ─────────────────────────────────────────────
DATA_DIR=data
